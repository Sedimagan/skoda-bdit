# Copy this to .env for LOCAL testing only. Never commit the real .env —
# it's already in .gitignore. On Hugging Face Spaces, set these same two
# names under Settings -> Variables and secrets instead.

SHEET_URL='https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/edit'

# Paste the ENTIRE downloaded service-account JSON key as one single-quoted
# string on one line (single quotes keep the inner double quotes literal).
GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}'
